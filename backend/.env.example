# Get a free API key at https://console.groq.com/keys
# Copy this file to `.env` and fill in your key, then load it before starting
# the server. Without this key, the Clinical Interpretation Agent
# automatically falls back to a rule-based explanation generator, so the
# app still runs end-to-end — you just won't get LLM-generated narratives.
GROQ_API_KEY=